# packages/backend — copy to .env (bun loads it on start). Every value has a default in src/config/params.ts.
CC_WWWROOT_PORT=30050
# The PWA shell to serve at / (the mobile build); empty = API only.
CC_WWWROOT_PATH=../../apps/mobile/dist

# Redis: the rooms, the lobby index, the TURN cache and the pub/sub between processes.
CC_REDIS_HOST=127.0.0.1
CC_REDIS_PORT=6379
CC_REDIS_USER=default
CC_REDIS_PASSWORD=

# MongoDB: the room journal (created / playing / finished / purged).
CC_MONGO_CONNECTION_STRING=mongodb://127.0.0.1:27017/skilltanki-mobile?wtimeoutMS=15000

# MinIO: the game assets served at /assets/* (seed with `npm run upload-assets`).
CC_MINIO_ENDPOINT=127.0.0.1
CC_MINIO_PORT=9000
CC_MINIO_USE_SSL=0
CC_MINIO_ACCESSKEY=minioadmin
CC_MINIO_SECRETKEY=minioadmin
CC_MINIO_BUCKET=skilltanki-mobile-assets

# Rooms: an empty room is purged after the grace, a dropped peer keeps its seat for the TTL, a silent listing is dropped.
CC_EMPTY_GRACE_MS=60000
CC_REJOIN_TTL_MS=120000
CC_LISTING_STALE_MS=600000

# ICE: STUN defaults to Google + Cloudflare; TURN is minted from the project's Cloudflare key (baked in) unless a relay of your own is set.
# CC_ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# CC_ICE_TURN_URL=turn:relay.example.com:3478
# CC_ICE_TURN_USERNAME=
# CC_ICE_TURN_CREDENTIAL=
# CC_CF_TURN_KEY_ID=
# CC_CF_TURN_API_TOKEN=
# CC_CF_TURN_TTL_S=86400

# Logs: 1 writes ./logs/backend-<key>.log (pinolog, rotated) besides the console.
CC_ENABLE_LOGS=0
