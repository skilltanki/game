// Local development of the API worker: `npm run dev:server` at the repo
// root — wrangler dev on :8787. The PWA shell is served by Vite on :5173,
// which proxies /assets, /api and /ws here (apps/mobile/vite.config.ts).
//
// Assets come from the R2 binding exactly as in production; in dev that is
// workerd's LOCAL bucket (.wrangler/state), seeded once — with this worker
// running — by
//   npm run upload-assets -- --local
// (it PUTs every file to /__dev/assets/*). No account is needed. To read the real bucket instead, add
// "remote": true to the r2 binding below (needs `wrangler login`).
//
// Production is the repo-root wrangler.jsonc (same worker, the real bucket,
// plus the Static Assets binding with the PWA shell).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mobile",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomObject" },
      // The lobby index: one object (name "lobby") with every listing — strongly consistent.
      { "name": "LOBBY_INDEX", "class_name": "LobbyObject" }
    ]
  },
  // SQLite backend from the first migration: it cannot be changed later.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject"] },
    // v2: the lobby index moved from KV into LobbyObject (migrate/2026-10-15-lobby-index-kv-to-do.mjs).
    { "tag": "v2", "new_sqlite_classes": ["LobbyObject"] }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "332f566313d1471080f16d208883829b" }],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "skilltanki-mobile-assets" }],
  "vars": {
    // Enables PUT /__dev/assets/* for `upload-assets --local` (dev only).
    "CC_DEV_SEED": "1",
    // Short in dev so scripts/test-signal.mjs can watch an empty room vanish.
    "CC_EMPTY_GRACE_MS": "5000",
    "CC_REJOIN_TTL_MS": "30000",
    "CC_LISTING_STALE_MS": "600000"
  },
  "dev": { "port": 8787 }
}
