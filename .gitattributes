# Game assets live at the repo root (assets/) and are committed in git-lfs:
# the deploy (scripts/build.mjs) copies this tree into build/public/assets and
# Workers Static Assets serves it — no upload script, no runtime assembly.
# Binaries go to lfs; the manifests (*.json) and map XML stay as readable text
# so hulls.json / maps.json / a map file are reviewable in a diff.
# A checkout without `git lfs pull` holds 130-byte pointer files: the build
# refuses to deploy them (see scripts/build.mjs verifyLfs).
assets/**/*.3ds filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/*.webp filter=lfs diff=lfs merge=lfs -text
